# ---------------------------------------------------------------------------
# FitTrack — environment configuration
#
# Copy to .env and adjust. NEVER commit a filled-in .env: it is gitignored.
# Every value below is a safe local-development default or a placeholder.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
ENVIRONMENT=development                  # development | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME=FitTrack API
API_V1_PREFIX=/api/v1
# Public URL of the user-facing app; used in verification / reset links.
APP_PUBLIC_URL=http://localhost:3000

# --- database --------------------------------------------------------------
# Async DSN used by the API and worker. Alembic strips the +asyncpg driver.
DATABASE_URL=postgresql+asyncpg://fittrack:fittrack@postgres:5432/fittrack
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- redis / background jobs ----------------------------------------------
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=fittrack:jobs

# --- authentication --------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_MIN_LENGTH=8

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=30/hour

# --- CORS ------------------------------------------------------------------
# Comma-separated. Lock this down to your real origins in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- object storage --------------------------------------------------------
# local: files on disk, served through /media with HMAC-signed URLs.
# s3:    any S3-compatible service (AWS S3, MinIO, Cloudflare R2).
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=./var/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media
# Address the API dials to reach storage, server to server.
S3_ENDPOINT=http://minio:9000
# Address written into the URLs clients receive. Presigned URLs are signed for
# the host they name, so this has to be an address the client can actually
# reach — `minio` only resolves between containers. Leave empty when storage is
# already public (AWS S3, R2) and the two addresses are the same.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fittrack
S3_ACCESS_KEY=fittrack
S3_SECRET_KEY=fittrack-dev-secret
S3_USE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic

# --- AI (FitCoach) ---------------------------------------------------------
# mock: fully local, no API key needed — the product works without AI.
# anthropic | openai: set AI_API_KEY to enable a hosted model.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60
AI_DAILY_MESSAGE_LIMIT=50

# --- email -----------------------------------------------------------------
# console: verification/reset links are written to the log (development).
EMAIL_PROVIDER=console
EMAIL_FROM=FitTrack <no-reply@fittrack.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- push notifications ----------------------------------------------------
# console: deliveries are logged. fcm: paste the service-account JSON.
PUSH_PROVIDER=console
FCM_CREDENTIALS_JSON=

# --- observability ---------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- admin dashboard (apps/admin) ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
